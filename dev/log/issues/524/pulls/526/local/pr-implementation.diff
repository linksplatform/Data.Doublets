diff --git a/cpp/Platform.Data.Doublets.Tests/TemporaryDirectoryTests.cpp b/cpp/Platform.Data.Doublets.Tests/TemporaryDirectoryTests.cpp
new file mode 100644
index 000000000..638ef27d8
--- /dev/null
+++ b/cpp/Platform.Data.Doublets.Tests/TemporaryDirectoryTests.cpp
@@ -0,0 +1,22 @@
+#include "../Tools/TemporaryDirectory.h"
+
+#include <fstream>
+
+namespace Platform::Data::Doublets::Tests
+{
+    TEST(TemporaryDirectoryTests, OwnsDistinctDirectoryAndCleansItUp)
+    {
+        std::filesystem::path path;
+        {
+            Tools::TemporaryDirectory first;
+            Tools::TemporaryDirectory second;
+            path = first.File("links");
+            EXPECT_NE(path.parent_path(), std::filesystem::path(second.File("links")).parent_path());
+            std::ofstream file(path);
+            file << "fixture";
+            file.close();
+            EXPECT_TRUE(std::filesystem::is_regular_file(path));
+        }
+        EXPECT_FALSE(std::filesystem::exists(path.parent_path()));
+    }
+} // namespace Platform::Data::Doublets::Tests
