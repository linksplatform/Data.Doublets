+        # --max-retries never retries a failure during the connect phase
+        # (lycheeverse/lychee#2297), so a healthy URL behind a connection
+        # reset is reported broken without one retry. Ask the URLs that got
+        # no answer again, outside lychee. Also retry 429 and 5xx with backoff
+        # (issue #68); permanent statuses such as 404 remain final.
+        if: steps.lychee.outputs.exit_code != 0
