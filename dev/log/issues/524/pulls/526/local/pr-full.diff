+            exit 1
+          fi
+          echo "root=$CSHARP_ROOT" >> "$GITHUB_OUTPUT"
+          echo "multi-language=$MULTI_LANGUAGE" >> "$GITHUB_OUTPUT"
+          echo "Detected C# layout: root=$CSHARP_ROOT, multi-language=$MULTI_LANGUAGE"
+
+      - name: Setup .NET
+        uses: actions/setup-dotnet@v5
+        with:
+          dotnet-version: '8.0.x'
+
+      - name: Restore dependencies
+        working-directory: ${{ steps.csharp_layout.outputs.root }}
+        shell: bash
+        run: bash scripts/run-with-budget-warning.sh 600 "dotnet restore (test)" dotnet restore
+
+      - name: Build
+        working-directory: ${{ steps.csharp_layout.outputs.root }}
+        shell: bash
+        run: bash scripts/run-with-budget-warning.sh 700 "dotnet build (test)" dotnet build --no-restore --configuration Release
+
+      - name: Run tests
+        working-directory: ${{ steps.csharp_layout.outputs.root }}
+        shell: bash
