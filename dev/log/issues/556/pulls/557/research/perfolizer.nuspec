<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Perfolizer</id>
    <version>0.7.5</version>
    <authors>Andrey Akinshin</authors>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>dino.png</icon>
    <projectUrl>https://github.com/AndreyAkinshin/perfolizer</projectUrl>
    <description>Performance analysis toolkit</description>
    <copyright>Copyright (C) 2020-2025 Andrey Akinshin</copyright>
    <tags>analysis performance tool</tags>
    <repository type="git" url="https://github.com/AndreyAkinshin/perfolizer" commit="435a0477f8d412c766b7ae22a400d8c6368451c4" />
    <dependencies>
      <group targetFramework="net6.0">
        <dependency id="Pragmastat" version="14.0.1" exclude="Build,Analyzers" />
      </group>
      <group targetFramework=".NETStandard2.0">
        <dependency id="Pragmastat" version="14.0.1" exclude="Build,Analyzers" />
        <dependency id="System.Memory" version="4.6.3" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>