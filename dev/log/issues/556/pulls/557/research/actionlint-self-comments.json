ylenhof/repos","events_url":"https://api.github.com/users/jylenhof/events{/privacy}","received_events_url":"https://api.github.com/users/jylenhof/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-01T19:54:11Z","updated_at":"2026-11-01T19:54:11Z","body":"For information, there's a fork with this fix and some more additions there :\nhttps://github.com/jdx/jactionlint","author_association":"CONTRIBUTOR","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6563058805/reactions","total_count":2,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":1},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6595796117","html_url":"https://github.com/rhysd/actionlint/issues/711#issuecomment-6595796117","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/711","id":6595796117,"node_id":"IC_kwDOFhfz288AAAABiSPclQ","user":{"login":"ShadowRZ","id":23130178,"node_id":"MDQ6VXNlcjIzMTMwMTc4","avatar_url":"https://avatars.githubusercontent.com/u/23130178?v=4","gravatar_id":"","url":"https://api.github.com/users/ShadowRZ","html_url":"https://github.com/ShadowRZ","followers_url":"https://api.github.com/users/ShadowRZ/followers","following_url":"https://api.github.com/users/ShadowRZ/following{/other_user}","gists_url":"https://api.github.com/users/ShadowRZ/gists{/gist_id}","starred_url":"https://api.github.com/users/ShadowRZ/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/ShadowRZ/subscriptions","organizations_url":"https://api.github.com/users/ShadowRZ/orgs","repos_url":"https://api.github.com/users/ShadowRZ/repos","events_url":"https://api.github.com/users/ShadowRZ/events{/privacy}","received_events_url":"https://api.github.com/users/ShadowRZ/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-03T04:54:54Z","updated_at":"2026-11-03T04:54:54Z","body":"> This is the hottest issue and I humbly request the owners to merge the PR soon.\n\nPing @rhysd for request to merge","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6595796117/reactions","total_count":2,"+1":2,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6605650086","html_url":"https://github.com/rhysd/actionlint/issues/711#issuecomment-6605650086","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/711","id":6605650086,"node_id":"IC_kwDOFhfz288AAAABibo4pg","user":{"login":"CarrotManMatt","id":108596565,"node_id":"U_kgDOBnkNVQ","avatar_url":"https://avatars.githubusercontent.com/u/108596565?v=4","gravatar_id":"","url":"https://api.github.com/users/CarrotManMatt","html_url":"https://github.com/CarrotManMatt","followers_url":"https://api.github.com/users/CarrotManMatt/followers","following_url":"https://api.github.com/users/CarrotManMatt/following{/other_user}","gists_url":"https://api.github.com/users/CarrotManMatt/gists{/gist_id}","starred_url":"https://api.github.com/users/CarrotManMatt/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/CarrotManMatt/subscriptions","organizations_url":"https://api.github.com/users/CarrotManMatt/orgs","repos_url":"https://api.github.com/users/CarrotManMatt/repos","events_url":"https://api.github.com/users/CarrotManMatt/events{/privacy}","received_events_url":"https://api.github.com/users/CarrotManMatt/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-03T13:54:08Z","updated_at":"2026-11-03T13:54:08Z","body":"The lack of response from maintainer suggests that this project has been abandoned and https://github.com/jdx/jactionlint or https://github.com/kjanat/actionlint should be used instead","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6605650086/reactions","total_count":1,"+1":0,"-1":1,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null},{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6672682896","html_url":"https://github.com/rhysd/actionlint/issues/711#issuecomment-6672682896","issue_url":"https://api.github.com/repos/rhysd/actionlint/issues/711","id":6672682896,"node_id":"IC_kwDOFhfz288AAAABjbkPkA","user":{"login":"konard","id":1431904,"node_id":"MDQ6VXNlcjE0MzE5MDQ=","avatar_url":"https://avatars.githubusercontent.com/u/1431904?v=4","gravatar_id":"","url":"https://api.github.com/users/konard","html_url":"https://github.com/konard","followers_url":"https://api.github.com/users/konard/followers","following_url":"https://api.github.com/users/konard/following{/other_user}","gists_url":"https://api.github.com/users/konard/gists{/gist_id}","starred_url":"https://api.github.com/users/konard/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/konard/subscriptions","organizations_url":"https://api.github.com/users/konard/orgs","repos_url":"https://api.github.com/users/konard/repos","events_url":"https://api.github.com/users/konard/events{/privacy}","received_events_url":"https://api.github.com/users/konard/received_events","type":"User","user_view_type":"public","site_admin":false},"created_at":"2026-11-05T23:54:20Z","updated_at":"2026-11-05T23:54:20Z","body":"Confirmed with the current actionlint 1.7.12 and zizmor 1.32.0 that the local-action spelling conflict remains. Minimal workflow (with an `action.yml` at `.github/actions/setup-node`):\n```yaml\nname: self action\non: workflow_dispatch\npermissions:\n  contents: read\njobs:\n  check:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v7.0.1\n      - uses: $/.github/actions/setup-node\n```\n`actionlint -shellcheck= -pyflakes= repro.yml` reports `\"$/.github/actions/setup-node\" is invalid value for \"uses\" ... ref is missing` at the local action. zizmor's self-repository guidance prefers the `$/' spelling, while `./.github/actions/setup-node` is accepted by actionlint and requires a narrow self-repository exception in zizmor.\n\nWe retain that narrow exception and the conventional `./` syntax; neither analyzer is disabled: https://github.com/link-foundation/sensitive-data-sanitizer/pull/103 . Accepting `$/' local-action references, as proposed in #732, would let downstream repositories remove this exception. The fixture and exact latest-version output are preserved in that PR's issue evidence.\n","author_association":"NONE","pin":null,"reactions":{"url":"https://api.github.com/repos/rhysd/actionlint/issues/comments/6672682896/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"performed_via_github_app":null,"minimized":null}]